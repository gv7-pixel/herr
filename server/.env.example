# Server port (provided automatically by Render in production)
PORT=5000

# Environment mode ('development' or 'production')
NODE_ENV=development

# Allowed frontend origin(s) for CORS (comma-separated if multiple)
# For local development: http://localhost:5173
# For production on Render: set to your Vercel URL, e.g. https://your-project.vercel.app
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173
